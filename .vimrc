syntax on                  " Enable syntax highlighting
set number                 " Show line numbers
set relativenumber         " Show relative line numbers (great for rapid jumping/deleting)
set encoding=utf-8         " Force UTF-8 encoding
set hidden                 " Allow switching buffers without saving first
set ttyfast                " Optimize smooth screen redrawing
set lazyredraw             " Don't redraw screen during macros (speeds up execution)
set tabstop=4              " Number of visual spaces per TAB
set softtabstop=4          " Number of spaces a TAB counts for while editing
set shiftwidth=4           " Number of spaces to use for autoindent
set expandtab              " Convert tabs to spaces
set autoindent             " Copy indent from current line when starting a new line
set smarttab               " Be smart when using tabs at the start of a link
set hlsearch               " Highlight all match results
set incsearch              " Show search matches as you type
set ignorecase             " Ignore case when searching...
set smartcase              " ...unless the search query contains an uppercase letter
set scrolloff=8            " Keep 8 lines above/below cursor when scrolling
set sidescrolloff=15       " Keep 15 columns to the left/right of cursor
set linebreak              " Wrap lines at convenient words rather than mid-word
set wildmenu               " Visual autocomplete menu for command mode
